{
  "version": 2,
  "builds": [
    {
      "src": "services/ai-engine/api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "services/ai-engine/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "services/ai-engine/api/index.py"
    }
  ]
}
